# ─────────────────────────────────────────────
# ECG SHE — Environment Variables
#
# Copy this file to `.env` and adjust values.
# The application is also runnable with NO `.env` at all (zero-config mode):
# everything below has a sensible local-development default.
# ─────────────────────────────────────────────

# General
NODE_ENV=development
TZ=Africa/Accra

# API
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# Database (driver-agnostic)
#
# Choose ONE engine via DB_TYPE. The application is identical across them:
#   sqlite | postgres | mssql | mysql | mariadb | oracle
#
# Default (no .env)         → SQLite, file at ./data/ecg-she.db (zero-config)
# Production target         → Azure SQL Database (DB_TYPE=mssql)
# ─────────────────────────────────────────────

# ── Default: zero-config SQLite (no Docker, no Postgres, no Azure)
DB_TYPE=sqlite
# Optional explicit path (defaults to ./data/ecg-she.db). Use ":memory:" for tests.
# DB_NAME=./data/ecg-she.db

# ── Example: PostgreSQL via docker-compose
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=ecg_she
# DB_PASSWORD=ecg_she_dev
# DB_NAME=ecg_she

# ── Example: Azure SQL Database (production)
# DB_TYPE=mssql
# DB_HOST=ecg-she.database.windows.net
# DB_PORT=1433
# DB_USERNAME=ecg_she_admin@ecg-she
# DB_PASSWORD=<azure-sql-password>
# DB_NAME=ecg_she
# DB_SSL=true
# When DB_SSL is true the API checks the server certificate and refuses TLS below 1.2.
# Production requires DB_SSL for every database except SQLite.

DB_LOGGING=false
DB_POOL_MAX=30
DB_POOL_MIN=5

# Auto-seed regions, districts and the test user accounts on first start.
# NODE_ENV=production forces this to false and refuses true.
BOOTSTRAP_AUTOSEED=true

# Development and test refuse DB_HOST=*.database.windows.net unless this is true.
# Leave it false. Do not restore a production backup into a developer database.
ALLOW_PRODUCTION_DATA=false

# Swagger UI. Development always serves /api/v1/docs.
# Production serves it only when this is true.
SWAGGER_ENABLED=false

# Redis (optional). Leave REDIS_ENABLED=false for zero-config — the app uses
# an in-process stub. Enable for multi-instance deployments.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_TLS=true

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
#  local  — Local accounts only (zero-config default)
#  entra  — Microsoft Entra ID only
#  hybrid — Either (production target: SSO + break-glass)
AUTH_PROVIDER=local

# Local JWT secrets. Development accepts the placeholders below.
# NODE_ENV=production rejects them, rejects the built-in dev defaults,
# and requires the access and refresh secrets to be different.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_REFRESH_TTL=7d

# ── Microsoft Entra ID (Azure AD) — leave blank to disable SSO
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUDIENCE=
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
ENTRA_POST_LOGOUT_URI=http://localhost:5173/login
ENTRA_GROUP_CLAIM=groups
# Map Entra group object-ids to application roles (comma-separated):
# ENTRA_GROUP_ROLE_MAP=00000000-...:SYS_ADMIN,11111111-...:GLOBAL_USER,22222222-...:REGIONAL_USER,33333333-...:DISTRICT_USER
ENTRA_GROUP_ROLE_MAP=
ENTRA_AUTO_SYNC=false

# MFA / TOTP
MFA_ISSUER=ECG-SHE

# Encryption (AES-256-GCM). Production rejects this placeholder and the built-in dev default.
# After a rotation, put the old value in DATA_ENCRYPTION_KEY_PREVIOUS so existing rows still open.
DATA_ENCRYPTION_KEY=change-me-to-a-random-32-byte-secret==
DATA_ENCRYPTION_KEY_PREVIOUS=

# Audit log. Rows are not deleted (the hash chain would break). Archive copies older than this many days.
# A warning is written when denied sign-ins and permission checks reach the count inside the window.
AUDIT_RETENTION_DAYS=365
AUDIT_ALERT_WINDOW_MINUTES=15
AUDIT_ALERT_AUTH_FAILURES=10

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_KEY=

# Mail / SMS / Push (all optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ecg.com.gh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:she@ecg.com.gh

# ─────────────────────────────────────────────
# Frontend (Vite — VITE_* are baked into the SPA bundle)
# ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
VITE_VAPID_PUBLIC_KEY=
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Microsoft Entra ID — leave blank to hide the "Sign in with Microsoft" button
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUDIENCE=
