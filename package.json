{
  "name": "ecg-she",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise SHE Management System for the Electricity Company of Ghana",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "glob": "^10.5.0",
    "prettier": "^3.3.3",
    "picomatch": "4.0.7",
    "postcss-selector-parser": "7.1.7",
    "tar": "7.5.22",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@nestjs/cli": {
      "glob": "10.5.0"
    },
    "tar": "$tar",
    "multer": "$multer",
    "follow-redirects": "$follow-redirects",
    "@angular-devkit/core": {
      "ajv": "8.20.0",
      "picomatch": "4.0.7"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.2"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "qs": "6.16.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "cors": "2.8.6",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@azure/msal-node": {
      "uuid": "11.1.1"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "postcss-selector-parser": "$postcss-selector-parser",
    "tailwindcss": {
      "postcss-selector-parser": "$postcss-selector-parser"
    },
    "postcss-nested": {
      "postcss-selector-parser": "$postcss-selector-parser"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "$js-yaml"
    }
  },
  "dependencies": {
    "follow-redirects": "1.16.1",
    "js-yaml": "5.5.0",
    "lodash": "4.18.1",
    "multer": "2.4.0"
  }
}
