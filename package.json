{
  "name": "ecg-she",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise SHE Management System for the Electricity Company of Ghana",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "glob": "^10.5.0",
    "prettier": "^3.3.3",
    "tar": "7.5.22",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@nestjs/cli": {
      "glob": "10.5.0"
    },
    "tar": "$tar"
  },
  "dependencies": {
    "lodash": "4.18.1"
  }
}
